CCEffect %{
  techniques:
  - passes:
    - vert: lamp-vs:vert
      frag: lamp-fs:frag
      depthStencilState: { depthTest: false, depthWrite: false }
      blendState:
        targets:
        - blend: true
          blendSrc: src_alpha
          blendDst: one_minus_src_alpha
          blendDstAlpha: one_minus_src_alpha
      rasterizerState: { cullMode: none }
      properties:
        alphaThreshold: { value: 0.01 }
        lightData: { value: [0.266, 0.7, 3.282051282, 0] }
        lightSettings: { value: [0.5, 0.07, 3.0, 0] }
        uvOriginU: { value: [0, 1, 1, 0] }
        uvVAspect: { value: [0, -1, 2, 0] }
}%

CCProgram lamp-vs %{
  precision highp float;
  #include <builtin/uniforms/cc-global>
  #if USE_LOCAL
    #include <builtin/uniforms/cc-local>
  #endif
  in vec3 a_position;
  in vec2 a_texCoord;
  in vec4 a_color;
  out vec2 uv0;
  out vec4 color;
  vec4 vert () {
    vec4 pos = vec4(a_position, 1.0);
    #if USE_LOCAL
      pos = cc_matWorld * pos;
    #endif
    #if USE_PIXEL_ALIGNMENT
      pos = cc_matView * pos;
      pos.xyz = floor(pos.xyz);
      pos = cc_matProj * pos;
    #else
      pos = cc_matViewProj * pos;
    #endif
    uv0 = a_texCoord;
    color = a_color;
    return pos;
  }
}%

CCProgram lamp-fs %{
  precision highp float;
  #include <builtin/internal/embedded-alpha>
  #include <builtin/internal/alpha-test>
  in vec2 uv0;
  in vec4 color;
  #pragma builtin(local)
  layout(set = 2, binding = 12) uniform sampler2D cc_spriteTexture;
  uniform LocalLight {
    vec4 lightData;
    vec4 lightSettings;
    vec4 uvOriginU;
    vec4 uvVAspect;
  };
  vec3 surface (vec2 p) {
    vec2 uv = uvOriginU.xy + uvOriginU.zw * clamp(p.x, 0.001, 0.999)
              + uvVAspect.xy * clamp(p.y, 0.001, 0.999);
    return CCSampleWithAlphaSeparated(cc_spriteTexture, uv).rgb;
  }
  float luminance (vec3 c) { return dot(c, vec3(0.2126, 0.7152, 0.0722)); }
  vec4 frag () {
    vec4 base = CCSampleWithAlphaSeparated(cc_spriteTexture, uv0);
    // Recover sprite-local coordinates even when its frame is packed/rotated.
    vec2 u = uvOriginU.zw, v = uvVAspect.xy, q = uv0 - uvOriginU.xy;
    float det = u.x * v.y - u.y * v.x;
    vec2 p = vec2(q.x * v.y - q.y * v.x, u.x * q.y - u.y * q.x) / det;
    float aspect = max(uvVAspect.z, 0.01);
    vec2 delta = (lightData.xy - p) * vec2(aspect, 1.0);
    float radius = max(lightData.z, 0.01);
    float falloff = pow(1.0 - smoothstep(0.0, radius, length(delta)), 2.0);
    float pulse = clamp(lightData.w, 0.0, 1.0);
    vec3 result = base.rgb;
    // No full-screen tint: only nearby surfaces receive or lose this lamp's light.
    if (falloff > 0.001) {
      vec2 stepUV = vec2(0.003 / aspect, 0.003);
      float dx = luminance(surface(p + vec2(stepUV.x, 0.0))) - luminance(surface(p - vec2(stepUV.x, 0.0)));
      float dy = luminance(surface(p + vec2(0.0, stepUV.y))) - luminance(surface(p - vec2(0.0, stepUV.y)));
      // Image-derived relief, not a geometry normal map or real occlusion.
      vec3 normal = normalize(vec3(-dx * lightSettings.z, -dy * lightSettings.z, 1.0));
      vec3 lightDir = normalize(vec3(delta / radius, 0.55));
      float diffuse = max(dot(normal, lightDir), 0.0);
      vec3 halfway = normalize(lightDir + vec3(0.0, 0.0, 1.0));
      float roughSpec = pow(max(dot(normal, halfway), 0.0), 18.0);
      float lum = luminance(base.rgb);
      float receive = smoothstep(0.02, 0.38, lum);
      vec3 reflected = base.rgb * vec3(1.0, 0.12, 0.065) * diffuse;
      vec3 specular = vec3(1.0, 0.19, 0.10) * roughSpec * receive * 0.16;
      result *= 1.0 - lightSettings.y * (1.0 - pulse) * falloff;
      result += (reflected + specular) * lightSettings.x * pulse * falloff;
    }
    vec4 o = vec4(result, base.a) * color;
    ALPHA_TEST(o);
    return o;
  }
}%
